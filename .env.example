# Copy to .env for local dev: cp .env.example .env

# --- Postgres ---
POSTGRES_USER=even
POSTGRES_PASSWORD=even
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Per-service DSNs (docker hostnames vs localhost)
AUTH_DATABASE_URL=postgres://even:even@localhost:5432/even_auth?sslmode=disable
MEDIA_DATABASE_URL=postgres://even:even@localhost:5432/even_media?sslmode=disable
LEXICON_DATABASE_URL=postgres://even:even@localhost:5432/even_lexicon?sslmode=disable
CONTENT_DATABASE_URL=postgres://even:even@localhost:5432/even_content?sslmode=disable
LEARNING_DATABASE_URL=postgres://even:even@localhost:5432/even_learning?sslmode=disable

# Cross-DB reads (legacy fallback when SERVICE_URL is unset)
# content  → LEARNING_SERVICE_URL or LEARNING_DATABASE_URL
# learning → CONTENT_SERVICE_URL, LEXICON_SERVICE_URL, MEDIA_SERVICE_URL (or matching *_DATABASE_URL)
# lexicon  → CONTENT_SERVICE_URL or CONTENT_DATABASE_URL
# auth     → CONTENT_SERVICE_URL + LEARNING_SERVICE_URL (or matching *_DATABASE_URL for platform stats)

# --- Inter-service HTTP (preferred in docker-compose) ---
INTERNAL_SERVICE_TOKEN=dev-internal-token
AUTH_SERVICE_URL=http://localhost:8081
CONTENT_SERVICE_URL=http://localhost:8083
LEARNING_SERVICE_URL=http://localhost:8084
LEXICON_SERVICE_URL=http://localhost:8082
MEDIA_SERVICE_URL=http://localhost:8085

# --- Gateway / CORS ---
# Comma-separated origins for production; empty = allow * (local dev)
CORS_ALLOWED_ORIGINS=

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=even-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# --- Auth ---
JWT_SECRET=dev-change-me-in-production

# --- Media storage ---
# Per-user quota in bytes (0 = unlimited). Platform admins bypass quota.
MEDIA_USER_QUOTA_BYTES=524288000

# --- Service ports (local go run) ---
HTTP_PORT_GATEWAY=8080
HTTP_PORT_AUTH=8081
HTTP_PORT_LEXICON=8082
HTTP_PORT_CONTENT=8083
HTTP_PORT_LEARNING=8084
HTTP_PORT_MEDIA=8085

# --- Gateway upstreams (local go run; docker-compose overrides to service hostnames) ---
AUTH_URL=http://localhost:8081
MEDIA_URL=http://localhost:8085
LEXICON_URL=http://localhost:8082
CONTENT_URL=http://localhost:8083
LEARNING_URL=http://localhost:8084

LOG_LEVEL=info

# --- Dev accounts (created on `just up` / `just seed-dev`) ---
DEV_PASSWORD=password123
DEV_TEACHER_EMAIL=teacher@even.local
DEV_STUDENT_EMAIL=student@even.local
PLATFORM_ADMIN_EMAIL=admin@even.local
PLATFORM_ADMIN_PASSWORD=password123
